{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": ["Bash(git * --output*)", "Bash(rtk git * --output*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "args": [],
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cloud-session-start.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [],
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rtk-rewrite.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
